<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AgriAI - Smart Soil & Seed Care Planner</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              400: '#4ade80',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
            },
            earth: {
              100: '#f7f3ee',
              500: '#8c6d53',
              700: '#5c4331',
              800: '#4a3525',
              900: '#2c1e14',
            },
            sun: {
              300: '#fde047',
              400: '#facc15',
              500: '#eab308',
              600: '#ca8a04',
            },
            water: {
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Chart.js for Soil Moisture Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #090d16 0%, #0f172a 40%, #062c21 100%);
      min-height: 100vh;
      color: #f8fafc;
    }

    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .glass-card-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card-hover:hover {
      transform: translateY(-4px);
      border-color: rgba(34, 197, 94, 0.4);
      box-shadow: 0 20px 30px -10px rgba(34, 197, 94, 0.15);
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(34, 197, 94, 0.3);
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(34, 197, 94, 0.6);
    }

    @keyframes pulseGlow {
      0% { box-shadow: 0 0 10px rgba(34, 197, 94, 0.2); }
      100% { box-shadow: 0 0 25px rgba(34, 197, 94, 0.5); }
    }

    .glow-active {
      animation: pulseGlow 2s infinite alternate;
    }

    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .glass-card {
        border: 1px solid #cccccc !important;
        background: #ffffff !important;
        box-shadow: none !important;
        color: #000000 !important;
      }
    }
  </style>
</head>
<body class="custom-scrollbar overflow-x-hidden antialiased selection:bg-brand-500 selection:text-white">

  <header class="sticky top-0 z-40 glass-card border-b border-slate-800/80 px-4 lg:px-8 py-3.5 no-print">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo & Title -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-emerald-400 flex items-center justify-center text-white shadow-lg shadow-brand-500/25">
          <i class="fa-solid fa-seedling text-xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-black tracking-tight bg-gradient-to-r from-emerald-400 via-green-200 to-teal-300 bg-clip-text text-transparent">
              AgriAI
            </h1>
            <span class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30">
              Vision & Weather Pro
            </span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">Soil Vision & Weather-Adaptive Plant Care Matrix</p>
        </div>
      </div>

      <!-- Quick Location & Saved Plants Navigation -->
      <div class="flex items-center space-x-3">
        <div id="locationBadge" class="hidden sm:flex items-center space-x-2 bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-700/80 text-xs text-slate-300">
          <i class="fa-solid fa-location-dot text-brand-400"></i>
          <span id="currentLocationText">Detecting location...</span>
        </div>

        <button onclick="toggleSavedGardenModal()" class="flex items-center space-x-2 bg-slate-800/90 hover:bg-slate-700/90 text-slate-200 px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-700/80 transition">
          <i class="fa-solid fa-book-bookmark text-amber-400"></i>
          <span>My Gardens (<span id="savedGardenCount">0</span>)</span>
        </button>
      </div>

    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 lg:px-8 py-6 space-y-8">

    <!-- Hero / Scanner Input Hub -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start no-print">
      
      <!-- Left Column: Vision Scanner Inputs -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="glass-card rounded-2xl p-6 relative overflow-hidden">
          <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <!-- Header and Presets Bar -->
          <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 mb-6">
            <div>
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-camera-retro text-brand-400"></i> Soil & Seed Scanner
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">Upload or take photos to analyze soil quality and seed species.</p>
            </div>

            <!-- Instant Sample Presets -->
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[11px] font-medium text-slate-400 mr-1">Sample Presets:</span>
              <button onclick="loadPreset('tomato')" class="text-[11px] bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg transition">Tomato</button>
              <button onclick="loadPreset('basil')" class="text-[11px] bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg transition">Basil</button>
              <button onclick="loadPreset('sunflower')" class="text-[11px] bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-slate-300 px-2.5 py-1 rounded-lg transition">Sunflower</button>
            </div>
          </div>

          <!-- Dual Photo Cards (Soil & Seed) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- 1. Soil Image Container -->
            <div class="bg-slate-900/90 border border-dashed border-slate-700 hover:border-brand-500/60 rounded-xl p-4 flex flex-col items-center justify-center min-h-[220px] relative transition group">
              <input type="file" id="soilFileInput" accept="image/*" class="hidden" onchange="handleFileSelect(event, 'soil')">
              
              <div id="soilPreviewContainer" class="hidden w-full h-full absolute inset-0 rounded-xl overflow-hidden group">
                <img id="soilPreviewImg" class="w-full h-full object-cover" alt="Soil preview">
                <div class="absolute inset-0 bg-slate-950/70 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2">
                  <button onclick="triggerFileInput('soil')" class="bg-slate-800/90 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fa-solid fa-arrows-rotate mr-1"></i> Change</button>
                  <button onclick="removeImage('soil')" class="bg-red-500/80 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fa-solid fa-trash mr-1"></i> Remove</button>
                </div>
                <div class="absolute bottom-2 left-2 bg-slate-950/90 text-emerald-400 text-[10px] font-semibold px-2.5 py-1 rounded-md border border-emerald-500/30 flex items-center gap-1">
                  <i class="fa-solid fa-circle-check"></i> Soil Sample Ready
                </div>
              </div>

              <div id="soilUploadPlaceholder" class="text-center space-y-2.5">
                <div class="w-12 h-12 mx-auto rounded-xl bg-earth-900/80 border border-earth-500/40 flex items-center justify-center text-earth-500 text-xl group-hover:scale-105 transition shadow-inner">
                  <i class="fa-solid fa-mound"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-200">1. Soil Sample Photo</p>
                  <p class="text-[11px] text-slate-400 mt-0.5">Capture garden dirt, pot soil, or peat mix</p>
                </div>
                <div class="flex items-center justify-center gap-2 pt-1">
                  <button onclick="triggerFileInput('soil')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-upload text-brand-400"></i> Upload
                  </button>
                  <button onclick="openWebcam('soil')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-camera text-sky-400"></i> Camera
                  </button>
                </div>
              </div>
            </div>

            <!-- 2. Seed Image Container -->
            <div class="bg-slate-900/90 border border-dashed border-slate-700 hover:border-brand-500/60 rounded-xl p-4 flex flex-col items-center justify-center min-h-[220px] relative transition group">
              <input type="file" id="seedFileInput" accept="image/*" class="hidden" onchange="handleFileSelect(event, 'seed')">
              
              <div id="seedPreviewContainer" class="hidden w-full h-full absolute inset-0 rounded-xl overflow-hidden group">
                <img id="seedPreviewImg" class="w-full h-full object-cover" alt="Seed preview">
                <div class="absolute inset-0 bg-slate-950/70 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2">
                  <button onclick="triggerFileInput('seed')" class="bg-slate-800/90 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fa-solid fa-arrows-rotate mr-1"></i> Change</button>
                  <button onclick="removeImage('seed')" class="bg-red-500/80 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fa-solid fa-trash mr-1"></i> Remove</button>
                </div>
                <div class="absolute bottom-2 left-2 bg-slate-950/90 text-amber-400 text-[10px] font-semibold px-2.5 py-1 rounded-md border border-amber-500/30 flex items-center gap-1">
                  <i class="fa-solid fa-circle-check"></i> Seed Sample Ready
                </div>
              </div>

              <div id="seedUploadPlaceholder" class="text-center space-y-2.5">
                <div class="w-12 h-12 mx-auto rounded-xl bg-amber-950/80 border border-amber-500/40 flex items-center justify-center text-amber-500 text-xl group-hover:scale-105 transition shadow-inner">
                  <i class="fa-solid fa-wheat-awn"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-200">2. Seed or Seed Packet Photo</p>
                  <p class="text-[11px] text-slate-400 mt-0.5">Photo of seeds or seed envelope label</p>
                </div>
                <div class="flex items-center justify-center gap-2 pt-1">
                  <button onclick="triggerFileInput('seed')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-upload text-brand-400"></i> Upload
                  </button>
                  <button onclick="openWebcam('seed')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-camera text-sky-400"></i> Camera
                  </button>
                </div>
              </div>
            </div>

          </div>

          <!-- Location & Context Settings -->
          <div class="mt-5 pt-4 border-t border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Target Growing City / Location</label>
              <div class="relative">
                <input type="text" id="userLocationInput" placeholder="e.g. Austin, Texas or London, UK" class="w-full bg-slate-900 border border-slate-700 focus:border-brand-500 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none pl-8 transition">
                <i class="fa-solid fa-location-arrow absolute left-2.5 top-2.5 text-slate-500 text-xs"></i>
                <button onclick="detectUserGPS()" class="absolute right-1.5 top-1.5 text-[11px] bg-slate-800 hover:bg-slate-700 text-brand-400 px-2 py-1 rounded-lg border border-slate-700/80 transition">
                  Auto-GPS
                </button>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Growing Environment</label>
              <select id="environmentType" class="w-full bg-slate-900 border border-slate-700 focus:border-brand-500 rounded-xl px-3 py-2 text-xs text-white focus:outline-none transition">
                <option value="Outdoor Garden Bed">Outdoor Garden Bed / Patch</option>
                <option value="Indoor Pot / Container">Indoor Container / Windowsill</option>
                <option value="Greenhouse">Greenhouse / Seedling Tent</option>
                <option value="Balcony Raised Bed">Balcony / Patio Raised Bed</option>
              </select>
            </div>
          </div>

          <!-- Submit Analysis Button -->
          <div class="mt-5">
            <button id="btnAnalyze" onclick="executeAgriAnalysis()" class="w-full bg-gradient-to-r from-brand-600 via-emerald-600 to-teal-600 hover:from-brand-500 hover:to-teal-500 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-brand-600/30 flex items-center justify-center space-x-2 transition text-sm">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>Analyze Soil, Seed & Local Weather Requirements</span>
            </button>
          </div>

        </div>

      </div>

      <!-- Right Column: Live Regional Weather & Insights -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Live Weather Card -->
        <div class="glass-card rounded-2xl p-6 relative">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2.5">
              <div class="w-9 h-9 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center border border-sky-500/30">
                <i class="fa-solid fa-cloud-sun text-lg"></i>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white">Live Microclimate Sync</h3>
                <p class="text-[11px] text-slate-400">Grounded Search Weather Feed</p>
              </div>
            </div>
            <button onclick="refreshWeatherInfo()" title="Refresh Weather Data" class="text-xs text-slate-400 hover:text-brand-400 p-1.5 bg-slate-800/80 rounded-lg border border-slate-700/80 transition">
              <i class="fa-solid fa-rotate"></i>
            </button>
          </div>

          <div id="weatherWidgetBody" class="space-y-4">
            <div class="flex items-center justify-between bg-slate-900/80 p-3.5 rounded-xl border border-slate-800">
              <div>
                <span id="weatherTemp" class="text-3xl font-black text-white tracking-tight">--°C</span>
                <p id="weatherConditionText" class="text-xs text-slate-400 mt-0.5">Fetching regional forecast...</p>
              </div>
              <div class="text-right">
                <span id="weatherLocationName" class="text-xs font-bold text-brand-400 block">--</span>
                <span class="text-[10px] text-slate-500 bg-slate-800 px-2 py-0.5 rounded border border-slate-700">Google Grounded</span>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2.5 text-center text-xs">
              <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <i class="fa-solid fa-droplet text-water-400 block mb-1 text-sm"></i>
                <span id="weatherHumidity" class="font-bold text-slate-200">--%</span>
                <p class="text-[10px] text-slate-500">Humidity</p>
              </div>
              <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <i class="fa-solid fa-sun text-sun-400 block mb-1 text-sm"></i>
                <span id="weatherUv" class="font-bold text-slate-200">--</span>
                <p class="text-[10px] text-slate-500">UV Index</p>
              </div>
              <div class="bg-slate-900/60 p-2.5 rounded-xl border border-slate-800">
                <i class="fa-solid fa-cloud-showers-heavy text-indigo-400 block mb-1 text-sm"></i>
                <span id="weatherRainProb" class="font-bold text-slate-200">--%</span>
                <p class="text-[10px] text-slate-500">Rain Chance</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Microclimate Agronomy Rules Box -->
        <div class="glass-card rounded-2xl p-6">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-3 flex items-center gap-2">
            <i class="fa-solid fa-lightbulb text-amber-400"></i> Smart Agronomy Rules
          </h3>
          <ul class="space-y-2.5 text-xs text-slate-300">
            <li class="flex items-start gap-2.5 bg-slate-900/60 p-3 rounded-xl border border-slate-800/80">
              <i class="fa-solid fa-seedling text-emerald-400 mt-0.5 text-sm"></i>
              <span>High germination temperatures require misting twice daily to prevent surface crusting.</span>
            </li>
            <li class="flex items-start gap-2.5 bg-slate-900/60 p-3 rounded-xl border border-slate-800/80">
              <i class="fa-solid fa-cloud-rain text-sky-400 mt-0.5 text-sm"></i>
              <span>Live atmospheric humidity overrides lower irrigation requirements to protect roots from rot.</span>
            </li>
          </ul>
        </div>

      </div>

    </section>

    <!-- Detailed Plant Care Results Dashboard -->
    <section id="resultsDashboard" class="hidden space-y-6">
      
      <!-- Top Overview & Export Header Bar -->
      <div class="glass-card rounded-2xl p-6 border-l-4 border-l-brand-500 relative">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span id="resPlantBadge" class="bg-brand-500/20 text-brand-400 border border-brand-500/30 text-xs px-3 py-1 rounded-full font-bold">Identified Seed</span>
              <span id="resSoilBadge" class="bg-earth-500/20 text-amber-300 border border-earth-500/30 text-xs px-3 py-1 rounded-full font-bold">Soil Type</span>
            </div>
            <h2 id="resPlantTitle" class="text-2xl font-black text-white mt-2 tracking-tight">Tomato Seed (Solanum lycopersicum)</h2>
            <p id="resPlantSummary" class="text-xs text-slate-300 mt-1 max-w-3xl leading-relaxed">Optimal condition detected for loamy potting mix under temperate sunny conditions.</p>
          </div>

          <div class="flex items-center gap-2.5 no-print">
            <button onclick="saveCurrentGardenPlan()" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition">
              <i class="fa-solid fa-bookmark"></i> Save Plan
            </button>
            <button onclick="printCarePlan()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3.5 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition">
              <i class="fa-solid fa-print"></i> Print / PDF
            </button>
          </div>
        </div>
      </div>

      <!-- 4 Core Metric Gauges Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Gauge 1: Sunlight Demand -->
        <div class="glass-card rounded-2xl p-5 border border-amber-500/20 relative overflow-hidden glass-card-hover">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-300">Sunlight Requirement</span>
            <i class="fa-solid fa-sun text-sun-400 text-lg"></i>
          </div>
          <div class="text-center py-2">
            <div id="sunlightHoursVal" class="text-3xl font-black text-amber-300">6 - 8 Hrs</div>
            <p id="sunlightTypeVal" class="text-xs text-slate-400 mt-0.5 font-medium">Full Direct Sunlight</p>
          </div>
          <div class="w-full bg-slate-800 h-2.5 rounded-full mt-3 overflow-hidden p-0.5 border border-slate-700">
            <div id="sunlightProgressBar" class="bg-gradient-to-r from-amber-500 to-sun-400 h-full rounded-full transition-all duration-700" style="width: 75%"></div>
          </div>
          <p id="sunlightAdviceText" class="text-[11px] text-slate-400 mt-3 border-t border-slate-800/80 pt-2.5 leading-relaxed">
            Position in direct unobstructed sunlight for maximum growth energy.
          </p>
        </div>

        <!-- Gauge 2: Water Volume & Frequency -->
        <div class="glass-card rounded-2xl p-5 border border-sky-500/20 relative overflow-hidden glass-card-hover">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-300">Water Volume & Schedule</span>
            <i class="fa-solid fa-droplet text-water-400 text-lg"></i>
          </div>
          <div class="text-center py-2">
            <div id="waterVolumeVal" class="text-3xl font-black text-sky-300">250 ml</div>
            <p id="waterFreqVal" class="text-xs text-slate-400 mt-0.5 font-medium">Every 2 Days (Morning)</p>
          </div>
          <div class="w-full bg-slate-800 h-2.5 rounded-full mt-3 overflow-hidden p-0.5 border border-slate-700">
            <div id="waterProgressBar" class="bg-gradient-to-r from-sky-500 to-water-400 h-full rounded-full transition-all duration-700" style="width: 60%"></div>
          </div>
          <p id="waterAdviceText" class="text-[11px] text-slate-400 mt-3 border-t border-slate-800/80 pt-2.5 leading-relaxed">
            Keep damp but not waterlogged to avoid seed drowning.
          </p>
        </div>

        <!-- Gauge 3: Soil Health Quality Score -->
        <div class="glass-card rounded-2xl p-5 border border-emerald-500/20 relative overflow-hidden glass-card-hover">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-slate-300">Soil Health Rating</span>
            <i class="fa-solid fa-chart-pie text-emerald-400 text-lg"></i>
          </div>
          <div class="text-center py-2">
            <div id="soilScoreVal" class="text-3xl font-black text-emerald-400">82 / 100</div>
            <p id="soilTypeDetectedText" class="text-xs text-slate-400 mt-0.5 font-medium">Organic Rich Loam</p>
          </div>
          <div class="w-full bg-slate-800 h-2.5 rounded-full mt-3 overflow-hidden p-0.5 border border-slate-700">
